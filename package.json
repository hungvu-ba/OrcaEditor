{
  "name": "orca-md-editor",
  "displayName": "Orca MD Editor",
  "description": "A fast, clean WYSIWYG editor for .md — drag-and-drop reorder, project-wide search, and a rich toolbar, all while keeping your Markdown source pristine and diff-friendly.",
  "version": "1.0.0",
  "publisher": "hungvu",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hungvu-ba/OrcaEditor.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Asset writes stay contained to the workspace even in a restricted/untrusted workspace (see the containment guard in src/fs-guard.ts). The two workspace-settable values below that could otherwise be used to redirect writes or spoof an author identity are restricted to User scope.",
      "restrictedConfigurations": [
        "orcaEditor.assetsPaste.customFolderPath",
        "orcaEditor.comments.authorName"
      ]
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "orcaEditor.editor",
        "displayName": "Orca MD Editor",
        "selector": [
          {
            "filenamePattern": "*.{md,markdown,mdown,mkd,mdwn,mdtxt,mdtext}"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "orcaEditor.open",
        "title": "Open Orca MD Editor",
        "category": "Markdown",
        "icon": "$(open-preview)"
      },
      {
        "command": "orcaEditor.openToSide",
        "title": "Open Orca MD Editor to the Side",
        "category": "Markdown",
        "icon": "$(open-preview)"
      },
      {
        "command": "orcaEditor.toggleReadingMode",
        "title": "Toggle Reading Mode",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.toggleZen",
        "title": "Toggle Focus Mode",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.openToc",
        "title": "Show/Hide Table of Contents",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.toggleTableFitMode",
        "title": "Toggle Table Fit Width",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.replyComment",
        "title": "Reply to Comment Thread",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.deleteComment",
        "title": "Delete Comment Thread",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.editComment",
        "title": "Edit Comment",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.saveEditComment",
        "title": "Save Comment Edit",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.cancelEditComment",
        "title": "Cancel Comment Edit",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.resolveComment",
        "title": "Mark Comment as Resolved",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.closeComment",
        "title": "Close Comment Thread",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.reopenComment",
        "title": "Reopen Comment Thread",
        "category": "Orca MD Editor"
      },
      {
        "command": "orcaEditor.copyCommentsAsMarkdown",
        "title": "Copy Comments as Markdown",
        "category": "Orca MD Editor"
      }
    ],
    "orcaEditorExecuteCommands": [
      "orcaEditor.toggleReadingMode",
      "orcaEditor.toggleZen",
      "orcaEditor.openToc",
      "orcaEditor.toggleTableFitMode"
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "orcaEditor.open",
          "when": "editorLangId == markdown"
        },
        {
          "command": "orcaEditor.openToSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "orcaEditor.replyComment",
          "when": "false"
        },
        {
          "command": "orcaEditor.deleteComment",
          "when": "false"
        },
        {
          "command": "orcaEditor.editComment",
          "when": "false"
        },
        {
          "command": "orcaEditor.saveEditComment",
          "when": "false"
        },
        {
          "command": "orcaEditor.cancelEditComment",
          "when": "false"
        },
        {
          "command": "orcaEditor.resolveComment",
          "when": "false"
        },
        {
          "command": "orcaEditor.closeComment",
          "when": "false"
        },
        {
          "command": "orcaEditor.reopenComment",
          "when": "false"
        },
        {
          "command": "orcaEditor.copyCommentsAsMarkdown",
          "when": "activeCustomEditorId == 'orcaEditor.editor'"
        }
      ],
      "editor/title": [
        {
          "command": "orcaEditor.openToSide",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "orcaEditor.open",
          "when": "resourceExtname =~ /\\.(md|markdown)$/ && activeCustomEditorId != 'orcaEditor.editor'",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "orcaEditor.open",
          "when": "resourceExtname =~ /\\.(md|markdown|mdown|mkd|mdwn|mdtxt|mdtext)$/",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "orcaEditor.open",
          "when": "resourceExtname =~ /\\.(md|markdown)$/",
          "group": "navigation@100"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "orcaEditor.replyComment",
          "group": "inline@1",
          "when": "commentController == orcaEditor.comments"
        },
        {
          "command": "orcaEditor.deleteComment",
          "group": "inline@2",
          "when": "commentController == orcaEditor.comments"
        },
        {
          "command": "orcaEditor.resolveComment",
          "group": "inline@3",
          "when": "commentController == orcaEditor.comments && commentThread =~ /status-open/"
        },
        {
          "command": "orcaEditor.closeComment",
          "group": "inline@4",
          "when": "commentController == orcaEditor.comments && commentThread =~ /status-resolved/"
        },
        {
          "command": "orcaEditor.reopenComment",
          "group": "inline@5",
          "when": "commentController == orcaEditor.comments && commentThread =~ /status-(resolved|closed)/"
        }
      ],
      "comments/comment/title": [
        {
          "command": "orcaEditor.editComment",
          "group": "inline@1",
          "when": "commentController == orcaEditor.comments && commentThread =~ /status-(open|resolved)/"
        }
      ],
      "comments/comment/context": [
        {
          "command": "orcaEditor.saveEditComment",
          "group": "inline@1",
          "when": "commentController == orcaEditor.comments"
        },
        {
          "command": "orcaEditor.cancelEditComment",
          "group": "inline@2",
          "when": "commentController == orcaEditor.comments"
        }
      ]
    },
    "keybindings": [
      {
        "command": "orcaEditor.openToSide",
        "key": "ctrl+shift+alt+v",
        "mac": "cmd+shift+alt+v",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Orca MD Editor",
      "properties": {
        "orcaEditor.autoOpenToc": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Table of Contents panel whenever a Markdown file is opened in WYSIWYG Preview."
        },
        "orcaEditor.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show line numbers (from the original Markdown file) in a gutter to the left of each content block (paragraph, heading, list, table, code, mermaid...), like the line-number gutter in raw text mode."
        },
        "orcaEditor.table.fitMode": {
          "type": "boolean",
          "default": true,
          "description": "Table Fit Width: shrink and wrap table columns to fit the panel width (capping columns dominated by one very long cell) instead of scrolling horizontally. This is the initial default; toggle it live per session with the 'Toggle Table Fit Width' command (global across all open Markdown tabs, not persisted)."
        },
        "orcaEditor.crossFileSearch.scope": {
          "type": "string",
          "enum": [
            "markdown",
            "allFiles"
          ],
          "enumDescriptions": [
            "Only search .md/.markdown files in the workspace.",
            "Search all text files in the workspace (respecting .gitignore and default excludes like node_modules, dist, images, binaries)."
          ],
          "default": "markdown",
          "description": "Default scope for the cross-file search triggered from a text selection in the preview. Can be overridden per-search via the dropdown in the results popover."
        },
        "orcaEditor.assetsPaste.location": {
          "type": "string",
          "enum": [
            "siblingAssetsFolder",
            "customFolder"
          ],
          "enumDescriptions": [
            "Save into an `assets/` subfolder next to the Markdown file being edited.",
            "Save into the folder specified by orcaEditor.assetsPaste.customFolderPath."
          ],
          "default": "siblingAssetsFolder",
          "description": "Where to save images pasted from the clipboard or dropped into the editor, and files dropped from outside the editor. Renamed from orcaEditor.pasteImage.* (default folder changed from images/ to assets/) when drag-and-drop support was added — existing images already saved under images/ are not moved."
        },
        "orcaEditor.assetsPaste.customFolderPath": {
          "type": "string",
          "default": "",
          "description": "Folder to save pasted/dropped images and dropped files into when orcaEditor.assetsPaste.location is \"customFolder\". Relative paths resolve against the workspace folder containing the Markdown file; absolute paths are used as-is."
        },
        "orcaEditor.assetsPaste.orphanCleanup.enabled": {
          "type": "boolean",
          "default": true,
          "description": "On save, permanently delete pasted/dropped images that are no longer referenced anywhere in this file (and not referenced by sibling Markdown files in the same folder). If the reference reappears later (e.g. via undo), the image is restored automatically. Does not apply to non-image files dropped into the editor — those are never auto-deleted."
        },
        "orcaEditor.comments.authorName": {
          "type": "string",
          "default": "",
          "description": "Name recorded as the author on review comments you create. Leave empty to use your OS username. This is a display name only — it is free text with no authentication behind it."
        },
        "orcaEditor.readability.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Turn on Reading Mode: apply the comfortable long-form reading layout (measure/typography). When off, newly opened tabs start in Standard (no reading style). This is the starting default for newly opened tabs; the Reading Mode button on the toolbar applies only to the current tab for the session and is not saved back here."
        },
        "orcaEditor.readability.readingMode": {
          "type": "string",
          "enum": [
            "standard",
            "sepia",
            "paper"
          ],
          "enumDescriptions": [
            "Standard: current behavior — full width, follow VS Code theme/font.",
            "Sepia: ~70ch measure, roomy line-height, warm low-blue sepia colors.",
            "Paper: ~70ch measure, roomy line-height, bright warm-white printed-page colors."
          ],
          "default": "standard",
          "description": "Which Reading Mode to apply when Reading Mode is on — the starting default for newly opened tabs. Picking a mode from the toolbar Reading Mode dropdown applies to the current tab only (not saved back here)."
        },
        "orcaEditor.readability.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Optional reading font override applied in Reading Mode. Type the name of a font installed on your machine (nothing is bundled/downloaded). Leave empty to use the reading mode's default font stack."
        },
        "orcaEditor.readability.zen": {
          "type": "boolean",
          "default": false,
          "description": "Focus Mode: hide the toolbar and line-number gutter and center the text column. This is the starting default for newly opened tabs; the Focus button on the toolbar applies only to the current tab for the session (not saved back here). Press Esc to exit."
        },
        "orcaEditor.trigger.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD",
          "description": "Format used by the `/` trigger popup's \"Insert today's date\" item. Supported tokens: YYYY, MM, DD, HH, mm, ss."
        },
        "orcaEditor.triggerActions.mode": {
          "type": "string",
          "enum": [
            "simple",
            "advanced"
          ],
          "enumDescriptions": [
            "Hide entity-related trigger actions (the @ Entities scope, /declare, /relate).",
            "Show every trigger action, including entity-related ones."
          ],
          "default": "advanced",
          "description": "Which trigger actions the @ and / popups offer. Advanced adds entity-related actions (Req 21) on top of the base set; Simple hides them. Only gates visibility — never restyles or removes already-written content."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:duplication": "jscpd",
    "check:deadcode": "ts-prune -p tsconfig.json --ignore 'test/|extension\\.ts'",
    "test:roundtrip": "node esbuild.js --test && node test/roundtrip-runner.js",
    "test:roundtrip:rendering": "node esbuild.js --test && node dist/test/roundtrip/rendering.js",
    "test:roundtrip:table": "node esbuild.js --test && node dist/test/roundtrip/table.js",
    "test:roundtrip:lists": "node esbuild.js --test && node dist/test/roundtrip/lists.js",
    "test:roundtrip:list-ops": "node esbuild.js --test && node dist/test/roundtrip/list-ops.js",
    "test:roundtrip:dom-normalize": "node esbuild.js --test && node dist/test/roundtrip/dom-normalize.js",
    "test:roundtrip:toolbar-format": "node esbuild.js --test && node dist/test/roundtrip/toolbar-format.js",
    "test:roundtrip:toolbar-insert": "node esbuild.js --test && node dist/test/roundtrip/toolbar-insert.js",
    "test:roundtrip:math-edit": "node esbuild.js --test && node dist/test/roundtrip/math-edit.js",
    "test:roundtrip:input-rules": "node esbuild.js --test && node dist/test/roundtrip/input-rules.js",
    "test:roundtrip:accessibility": "node esbuild.js --test && node dist/test/roundtrip/accessibility.js",
    "test:roundtrip:drag-drop": "node esbuild.js --test && node dist/test/roundtrip/drag-drop.js",
    "test:roundtrip:paste-image": "node esbuild.js --test && node dist/test/roundtrip/paste-image.js",
    "test:roundtrip:style-preservation": "node esbuild.js --test && node dist/test/roundtrip/style-preservation.js",
    "test:roundtrip:autolink-path": "node esbuild.js --test && node dist/test/roundtrip/autolink-path.js",
    "test:roundtrip:bare-url-decode": "node esbuild.js --test && node dist/test/roundtrip/bare-url-decode.js",
    "test:roundtrip:caption-insert": "node esbuild.js --test && node dist/test/roundtrip/caption-insert.js",
    "test:roundtrip:entity-ref": "node esbuild.js --test && node dist/test/roundtrip/entity-ref.js",
    "test:roundtrip:empty-link": "node esbuild.js --test && node dist/test/roundtrip/empty-link.js",
    "test:roundtrip:front-matter": "node esbuild.js --test && node dist/test/roundtrip/front-matter.js",
    "test:roundtrip:paste-text": "node esbuild.js --test && node dist/test/roundtrip/paste-text.js",
    "test:roundtrip:links": "node esbuild.js --test && node dist/test/roundtrip/links.js",
    "test:roundtrip:incremental-serialize": "node esbuild.js --test && node dist/test/roundtrip/incremental-serialize.js",
    "test:unit": "node esbuild.js --test && node dist/test/unit.js",
    "test:webview": "node esbuild.js --test && playwright test",
    "test:host": "node esbuild.js --test && node dist/test/host/runTest.js",
    "test": "npm run check:css-comments && npm run test:roundtrip && npm run test:unit && npm run test:webview && npm run test:host",
    "shots": "node esbuild.js --test && playwright test --config playwright.shots.config.ts",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "release": "./build.sh release",
    "check:css-comments": "node scripts/check-css-comments.js",
    "check:cross-platform": "node scripts/check-cross-platform.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/turndown": "^5.0.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "jscpd": "^5.0.12",
    "ts-prune": "^0.9.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.44.0"
  },
  "dependencies": {
    "@plantuml/core": "^1.2026.6",
    "@vscode/markdown-it-katex": "^1.1.1",
    "highlight.js": "^11.10.0",
    "js-yaml": "^4.3.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0",
    "smol-toml": "^1.7.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
